{
  "name": "obsidian-context-bridge",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "observability": {
    "enabled": false
  },
  "vars": {
    "PUBLIC_ORIGIN": "https://obsidian-context-bridge.YOUR_SUBDOMAIN.workers.dev",
    "WEBDAV_ROOT": "obsidian",
    "ACCESS_MODE": "vault",
    "ALLOWED_NOTES": ""
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "REPLACE_WITH_KV_NAMESPACE_ID"
    }
  ],
  "d1_databases": [
    {
      "binding": "SEARCH_DB",
      "database_name": "obsidian-context-search",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID"
    }
  ],
  "triggers": {
    "crons": [
      "* * * * *"
    ]
  }
}
